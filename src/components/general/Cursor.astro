<span
  data-component="cursor"
  style={{
    transform: "translate3d(50dvw, -20px, 0)",
  }}
  class="pointer-events-none fixed z-[51] hidden h-0 w-0 items-center justify-center overflow-visible lg:block"
>
  <span
    class="absolute block h-4 w-4 translate-x-[-50%] translate-y-[-50%] bg-[hsl(var(--color-primary)_h_s_l_/_70%)]"
  ></span>
</span>
<style is:global>
  [data-component="cursor"] {
    will-change: transform;
  }

  [data-component="cursor"] span {
    will-change: transform;
    transition: transform 0.1s ease-in-out;
    transform: scale(1);
    backdrop-filter: blur(0px) invert(100%);
    border-radius: var(--border-radius-general);
  }

  body {
    cursor: none;
  }

  @media (width <= 64rem) {
    body {
      cursor: auto;
    }
  }

  /* States are toggled from JS (see script below) instead of
     `body:has(a:hover, …)`, which forces document-wide style
     invalidation on every hover change. */
  [data-component="cursor"].is-hover {
    transition: transform 0.1s ease;

    span {
      transform: scale(2);
    }
  }
  [data-component="cursor"].is-hover.is-active span {
    transform: scale(0.33);
  }
  [data-component="cursor"].is-hidden span,
  [data-component="cursor"].is-hidden.is-hover.is-active span {
    transform: scale(0);
  }
</style>
<script>
  const cursor = document.querySelector(
    "[data-component='cursor']",
  )! as HTMLElement;

  const HOVERABLE = "button, a, .hoverable, .cursor-pointer";
  const INVERTED = ".inverted";

  let run = 0;
  let x = 0;
  let y = 0;
  // id of the requestAnimationFrame already scheduled, 0 = none pending.
  let pendingFrameId = 0;

  const applyCursorPosition = () => {
    pendingFrameId = 0;
    cursor.style.transform = `translate3d(${x}px, ${y}px, 0)`;
  };

  const handleMouseMove = (e: MouseEvent) => {
    x = e.clientX;
    y = e.clientY;
    // One style write per frame, no matter how many mousemove events fire.
    if (!pendingFrameId) {
      pendingFrameId = requestAnimationFrame(applyCursorPosition);
    }

    // avoid first cursor appears animation
    if (run >= 2 && !cursor.classList.contains("active")) {
      cursor.classList.add("active");
    }
    if (run < 2) {
      run++;
    }
  };

  const updateHoverState = (target: EventTarget | null) => {
    const el = target instanceof Element ? target : null;
    cursor.classList.toggle("is-hover", !!el?.closest(HOVERABLE));
    cursor.classList.toggle("is-hidden", !!el?.closest(INVERTED));
  };

  window.addEventListener("mousemove", handleMouseMove, { passive: true });
  document.addEventListener("pointerover", (e) => updateHoverState(e.target));
  document.addEventListener("pointerdown", () =>
    cursor.classList.add("is-active"),
  );
  document.addEventListener("pointerup", () =>
    cursor.classList.remove("is-active"),
  );
</script>
